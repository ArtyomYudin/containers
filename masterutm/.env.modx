# ==========================================
# Данные из ConfigMap (modx-config)
# ==========================================
HTML_ROOT=/app
MODX_INSTALL_TYPE=cli

# Указывает на имя сервиса MariaDB в docker-compose
MODX_DB_SERVER=mariadb

# Переменные для MODX (скрипт инициализации явно требует префикс MYSQL_)
MYSQL_DATABASE=masterutm
MYSQL_USER=masterutm

# Оставляем и MARIADB_* для совместимости (на случай, если скрипт проверяет и их)
MARIADB_DATABASE=masterutm
MARIADB_USER=masterutm

MODX_TABLE_PREFIX=modx_
MODX_DB_CONNECTION_CHARSET=utf8mb4
MODX_DB_CHARSET=utf8mb4
MODX_DB_CHARSET_COLLATION=utf8mb4_unicode_ci
MODX_HTTP_HOST=nginx
MODX_HTTPS_PORT=443
MODX_LANGUAGE=ru
MODX_CMS_ADMIN=admin
MODX_CMS_EMAIL=admin@masterutm.local
MODX_REMOVE_SETUP_DIRECTORY=1
MODX_CORE_PATH=/app/core/
MODX_CONTEXT_CONNECTORS_PATH=/app/connectors/
MODX_CONTEXT_CONNECTORS_URL=/connectors/
MODX_CONTEXT_MANAGER_PATH=/app/manager/
MODX_CONTEXT_MANAGER_URL=/manager/
MODX_CONTEXT_WEB_PATH=/app/
MODX_CONTEXT_WEB_URL=/

# ==========================================
# Данные из Secret (modx-secret + db-credentials)
# ==========================================
# Пароли также дублируются с обоими префиксами для гарантированной совместимости
MARIADB_PASSWORD=xB3eq0TNWGTI
MYSQL_PASSWORD=xB3eq0TNWGTI
MODX_CMS_PASS=admin

# Пароль root только для инициализации самого контейнера MariaDB
MARIADB_ROOT_PASSWORD=J76UgLd7Kxdv